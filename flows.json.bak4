    {
        "id": "niluchgraw010000",
        "type": "function",
        "z": "nilussvctab0001",
        "name": "topic /in→/raw",
        "func": "// Append /raw suffix to msg.topic, stripping /in if present.\n// Returns null if topic is empty (e.g., file-in trigger) so we don't publish junk.\nconst t = msg.topic || '';\nif (!t) return null;\nmsg.topic = t.endsWith('/in') ? t.slice(0, -3) + '/raw' : t + '/raw';\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 980,
