    {
        "id": "wsenfnvalid0001",
        "type": "function",
        "z": "wsenseflw00000001",
        "name": "wsense-validate",
        "func": "// Faithful to Python's validate_wsense_format → validate_json_str: just confirm it parses.\nlet parsed;\ntry {\n    parsed = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload;\n} catch (e) {\n    msg.error = 'WSense JSON parse: ' + e.message;\n    return [null, msg];\n}\nmsg.payload = parsed;\nreturn [msg, null];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 280,
        "y": 180,
        "wires": [
            [
                "wsenfnprojct001"
            ],
            []
        ]
    },
    {
        "id": "wsenfnprojct001",
        "type": "function",
        "z": "wsenseflw00000001",
        "name": "wsense-project",
        "func": "// Mirrors wsense_converter.convert() from data_transformer.\nconst payload = msg.payload;\nconst definitions = payload.definitions || [];\n\nif (!payload.nodes) {\n    msg.error = 'WSense: missing <nodes>';\n    return [null, msg];\n}\n\nconst getDefUnit = (defs, name) => {\n    const d = defs.find(x => x && x.name === name);\n    return d ? (d.unit ?? null) : null;\n};\n\nconst rows = [];\nlet metadata = null;\n\nfor (const wrap of payload.nodes) {\n    const node = wrap?.node;\n    if (!node) { msg.error = 'WSense: missing node.node'; return [null, msg]; }\n    const coords = node.coordinates;\n    if (!coords) { msg.error = 'WSense: missing node.coordinates'; return [null, msg]; }\n    const location = { latitude: coords.latitude, longitude: coords.longitude };\n\n    metadata = {\n        description: 'Wsense data from B2B API',\n        timeseries: 'wsense',\n        origin: node.name\n    };\n\n    const sourceIdByTree = {};\n    for (const probe of (node.children || [])) {\n        sourceIdByTree[probe.treeId] = probe.id;\n    }\n\n    if (!Array.isArray(node.data)) {\n        msg.error = 'WSense: missing node.data';\n        return [null, msg];\n    }\n\n    for (const paramWrap of node.data) {\n        // {param_name: {data: [...]}}\n        const entries = Object.entries(paramWrap);\n        for (const [paramName, paramVal] of entries) {\n            const unitRaw = getDefUnit(definitions, paramName);\n            if (unitRaw === null || unitRaw === undefined) {\n                msg.error = \"WSense: missing unit in definitions for '\" + paramName + \"'\";\n                return [null, msg];\n            }\n            // Python: \"battery\" in parameter_unit.lower() -> SOURCE else WATER\n            const scope = unitRaw.toLowerCase().includes('battery') ? 'SOURCE' : 'WATER';\n\n            const dataArr = paramVal?.data;\n            if (!Array.isArray(dataArr)) continue;\n\n            for (const dp of dataArr) {\n                let time;\n                try {\n                    const d = new Date(dp.timestamp);\n                    if (isNaN(d.getTime())) throw new Error('bad date');\n                    time = d.toISOString().replace('Z', '+00:00');\n                } catch (e) {\n                    msg.error = 'WSense: bad timestamp ' + dp.timestamp;\n                    return [null, msg];\n                }\n                const sensorId = sourceIdByTree[dp.probe_type] || '';\n                rows.push({\n                    time,\n                    location,\n                    hub_source_id: node.id,\n                    sensor_id: sensorId,\n                    parameter_raw: paramName,\n                    value: dp.value,\n                    unit_raw: unitRaw,\n                    scope\n                });\n            }\n        }\n    }\n}\n\nmsg.payload = { metadata, rows };\nreturn [msg, null];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 180,
        "wires": [
            [
                "wsensubcmems001"
            ],
            []
        ]
    },
