    {
        "id": "nilusfnvalid001",
        "type": "function",
        "z": "nilusflw00000001",
        "name": "nilus-validate",
        "func": "// JSON parse only (no formal schema for Nilus today).\nlet parsed;\ntry {\n    parsed = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload;\n} catch (e) {\n    msg.error = 'Nilus JSON parse: ' + e.message;\n    return [null, msg];\n}\nmsg.payload = parsed;\nreturn [msg, null];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 280,
        "y": 180,
        "wires": [
            [
                "nilusfnprojct01"
            ],
            []
        ]
    },
    {
        "id": "nilusfnprojct01",
        "type": "function",
        "z": "nilusflw00000001",
        "name": "nilus-project",
        "func": "// Mirrors nilus_converter.convert():\n//   nilus_message[1].sender_id\n//   nilus_message[2].date  -> DataPoint.time\n//   nilus_message[3].{low_band, high_band, samples}\n// All rows share time + sender. Spectrum samples become one row each.\nconst payload = msg.payload;\nconst nm = payload.nilus_message;\nif (!Array.isArray(nm) || nm.length < 4) {\n    msg.error = 'Nilus: missing/short nilus_message';\n    return [null, msg];\n}\n\nconst sender = nm[1]?.sender_id;\nconst created = nm[2]?.date;\nconst spec = nm[3] || {};\nif (sender === undefined || created === undefined) {\n    msg.error = 'Nilus: missing sender_id or timestamp';\n    return [null, msg];\n}\nconst senderId = String(sender);\nconst lowBand  = spec.low_band;\nconst highBand = spec.high_band;\nconst samples  = Array.isArray(spec.samples) ? spec.samples : [];\n\nconst baseRow = {\n    time: created,\n    location: null,\n    hub_source_id: senderId,\n    sensor_id: senderId,\n    scope: 'SOURCE'   // skip CMEMS lookup; Nilus params are domain-specific\n};\n\nconst rows = [];\nif (lowBand !== undefined) {\n    rows.push({ ...baseRow, parameter_raw: 'low_band',  value: lowBand,  unit_raw: 'Hz' });\n}\nif (highBand !== undefined) {\n    rows.push({ ...baseRow, parameter_raw: 'high_band', value: highBand, unit_raw: 'Hz' });\n}\nfor (const s of samples) {\n    rows.push({ ...baseRow, parameter_raw: 'spectrum', value: s, unit_raw: 'dB' });\n}\n\nmsg.payload = {\n    metadata: {\n        description: 'NILUS Node Data',\n        timeseries: 'AUSTEVOLL_NILUS 2024 Field Test',\n        origin:     'AUSTEVOLL_NILUS 2024 Field Test'\n    },\n    rows\n};\nreturn [msg, null];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 180,
        "wires": [
            [
                "nilussubcmems01"
            ],
            []
        ]
    },
