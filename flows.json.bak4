    {
        "id": "26da5b9af011ad69",
        "type": "function",
        "z": "de0d27225549eda2",
        "name": "lookup",
        "func": "const table = context.get('table');\nconst WATER = context.get('WATER');\nconst AIR = context.get('AIR');\nconst { metadata, rows } = msg.payload;\n\nmsg.payload = {\n    metadata,\n    rows: rows.map(r => {\n        const scope = (r.scope || 'WATER').toUpperCase();\n        if (scope === 'SOURCE') {\n            return { ...r, parameter: r.parameter_raw, unit: r.unit_raw };\n        }\n        const needle = (r.parameter_raw || '').toLowerCase();\n        const cats = scope === 'AIR' ? AIR : WATER;\n        const hit = table.find(x =>\n            (x.variable.includes(needle) || x.longName.includes(needle))\n            && cats.has(x.category)\n        );\n        return hit\n            ? { ...r, parameter: hit.stdName, unit: hit.unit }\n            : { ...r, parameter: r.parameter_raw, unit: r.unit_raw };\n    })\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "const text = fs.readFileSync(env.get('CSV_PATH'), 'utf8');\nconst lines = text.split(/\\r?\\n/).filter(l => l.trim());\nconst header = lines[0].split(',');\nconst idx = name => header.indexOf(name);\nconst cCat = idx('Category');\nconst cVar = idx('variable name');\nconst cLong = idx('long_name');\nconst cUnit = idx('unit');\nconst cStd = idx('CF standard_name');\n\nconst table = lines.slice(1).map(l => {\n    const c = l.split(',');\n    return {\n        category: (c[cCat] || '').toLowerCase(),\n        variable: (c[cVar] || '').toLowerCase(),\n        longName: (c[cLong] || '').toLowerCase(),\n        unit: c[cUnit] || '',\n        stdName: c[cStd] || ''\n    };\n});\n\ncontext.set('table', table);\ncontext.set('WATER', new Set(['physical oceanography', 'bgc', 'sea level', 'waves']));\ncontext.set('AIR', new Set(['meteorological']));",
        "finalize": "",
        "libs": [
            {
                "var": "fs",
                "module": "fs"
            }
        ],
        "x": 500,
        "y": 100,
        "wires": [
            []
        ]
    },
    {
        "id": "429333529bfa2de0",
        "type": "function",
        "z": "815da58933cee030",
        "name": "assemble",
        "func": "  const { metadata, rows } = msg.payload;\n  const formatVersion = env.get('FORMAT_VERSION') || 'SMARTOCEAN_V1';\n\n  const groups = new Map();\n  for (const r of rows) {\n      const locKey = r.location\n          ? `${r.location.latitude},${r.location.longitude}`\n          : 'null';\n      const key = `${r.time}|${locKey}|${r.hub_source_id}`;\n\n      if (!groups.has(key)) {\n          const dp = {\n              source_id: r.hub_source_id,\n              time: r.time,\n              observations: []\n          };\n          if (r.location) dp.location = r.location;\n          groups.set(key, dp);\n      }\n\n      groups.get(key).observations.push({\n          source_id: r.sensor_id,\n          parameter: r.parameter,\n          value: r.value,\n          unit: r.unit,\n          qualityCodes: r.qualityCodes || [0]\n      });\n  }\n\n  msg.payload = {\n      format: formatVersion,\n      metadata: metadata,\n      data: Array.from(groups.values())\n  };\n  return msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 510,
        "y": 100,
        "wires": [
            []
        ]
    },
    {
        "id": "84b4c1ea3eba27f3",
        "type": "function",
        "z": "5abdf5e22350bc81",
        "name": "validate",
        "func": "const validate = context.get('validate');\nif (validate(msg.payload)) {\n    return [msg, null];\n}\nmsg.error = JSON.stringify(validate.errors);\nreturn [null, msg];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "const schemaText = fs.readFileSync(env.get('SCHEMA_PATH'), 'utf8');\nconst schema = JSON.parse(schemaText);\nconst ajv = new Ajv({ allErrors: true });\ncontext.set('validate', ajv.compile(schema));\n",
        "finalize": "",
        "libs": [
            {
                "var": "fs",
                "module": "fs"
            },
            {
                "var": "Ajv",
                "module": "ajv"
            }
        ],
        "x": 360,
        "y": 180,
        "wires": [
            [],
            []
        ]
    },
    {
        "id": "f172c13388b8dd7e",
        "type": "function",
        "z": "45c14f8d381b5701",
        "name": "aadi-validate",
        "func": "const xmlString = typeof msg.payload === 'string'\n    ? msg.payload\n    : msg.payload.toString('utf8');\n\nconst result = await xmllint.validateXML({\n    xml: xmlString,\n    schema: context.get('mainSchema'),\n    preload: context.get('preload')\n});\n\nif (result.errors.length === 0) {\n    msg.payload = xmlString;\n    return [msg, null];\n}\nmsg.error = 'XSD: ' + result.errors.join('; ');\nreturn [null, msg];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "const SCHEMA_DIR = '/home/jonas/Skule/noderedsmartocean/schemas';\ncontext.set('mainSchema', fs.readFileSync(`${SCHEMA_DIR}/RTOutSchema.xsd`, 'utf8'));\ncontext.set('preload', [\n    { fileName: 'RTConfigSchema.xsd',       contents: fs.readFileSync(`${SCHEMA_DIR}/RTConfigSchema.xsd`, 'utf8') },\n    { fileName: 'RTDeviceLayoutSchema.xsd', contents: fs.readFileSync(`${SCHEMA_DIR}/RTDeviceLayoutSchema.xsd`, 'utf8') }\n]);\n",
        "finalize": "",
        "libs": [
            {
                "var": "fs",
                "module": "fs"
            },
            {
                "var": "xmllint",
                "module": "xmllint-wasm"
            }
        ],
        "x": 400,
        "y": 180,
        "wires": [
            [
                "56c5716ee34f89e0"
            ],
            []
        ]
    },
    {
        "id": "56c5716ee34f89e0",
        "type": "xml",
        "z": "45c14f8d381b5701",
        "name": "parse XML",
        "property": "payload",
        "attr": "",
        "chr": "",
        "x": 710,
        "y": 140,
        "wires": [
            [
                "87bf2b14a2173897"
            ]
        ]
    },
    {
        "id": "87bf2b14a2173897",
        "type": "function",
        "z": "45c14f8d381b5701",
        "name": "aadi-project",
        "func": "const device = msg.payload.Device;\nif (!device) { msg.error = 'missing <Device>'; return [null, msg]; }\n\nconst attr = device.$ || {};\nif (!attr.Descr)     { msg.error = 'missing Device @Descr';     return [null, msg]; }\nif (!attr.ID)        { msg.error = 'missing Device @ID';        return [null, msg]; }\nif (!attr.SessionID) { msg.error = 'missing Device @SessionID'; return [null, msg]; }\n\nconst deviceDescr = attr.Descr;\nconst deviceId    = attr.ID;\nconst sessionId   = attr.SessionID;\n\nif (!device.SystemInformation) {\n    msg.error = 'missing <SystemInformation>';\n    return [null, msg];\n}\nconst sysInfoContainer = device.SystemInformation?.[0];\nif (!sysInfoContainer || typeof sysInfoContainer !== 'object' || !sysInfoContainer.SystemInfo) {\n    msg.error = 'missing <SystemInfo>';\n    return [null, msg];\n}\nconst sysInfoList = sysInfoContainer.SystemInfo;\n\nconst findSysInfo = (descr) => {\n    const hit = sysInfoList.find(i => i.$?.Descr === descr);\n    return hit?._ || '';\n};\nconst locationDescr = findSysInfo('Location ');\nconst geoPosition   = findSysInfo('GeoPosition');\n\nlet location = null;\nconst parts = (geoPosition || '').split(',');\nif (parts.length === 2) {\n    const lat = parseFloat(parts[0]);\n    const lon = parseFloat(parts[1]);\n    if (!isNaN(lat) && !isNaN(lon)) location = { latitude: lat, longitude: lon };\n}\n\nconst data = device.Data?.[0];\nif (!data) { msg.error = 'missing <Data>'; return [null, msg]; }\nif (!data.Time || !data.Time[0])  { msg.error = 'missing <Data><Time>';  return [null, msg]; }\nif (!data.SensorData)             { msg.error = 'missing <SensorData>';  return [null, msg]; }\nif (!data.SystemData)             { msg.error = 'missing <SystemData>';  return [null, msg]; }\n\nconst dataTime = data.Time[0].replace('Z', '+00:00');\n\nlet sensors = [...data.SensorData];\nconst sysList = Array.isArray(data.SystemData) ? data.SystemData : [data.SystemData];\nsensors.push(...sysList);\n\nconst rows = [];\nfor (const sensor of sensors) {\n    if (!sensor.$?.ID)      { msg.error = 'sensor missing @ID';          return [null, msg]; }\n    if (!sensor.Parameters) { msg.error = 'sensor missing <Parameters>'; return [null, msg]; }\n    const params = sensor.Parameters?.[0];\n    if (!params?.Point)     { msg.error = 'sensor missing <Point>';      return [null, msg]; }\n\n    const sensorId = sensor.$.ID;\n    const points = Array.isArray(params.Point) ? params.Point : [params.Point];\n    for (const point of points) {\n        // Python's create_observation_from_point wraps in try/except and\n        // returns None for any point that raises (missing Value, etc.) -> skip.\n        const valueEl = point.Value;\n        if (valueEl === undefined || valueEl === null) continue;\n        const value = Array.isArray(valueEl) ? valueEl[0] : valueEl;\n        rows.push({\n            time: dataTime,\n            location,\n            hub_source_id: deviceId,\n            sensor_id: sensorId,\n            parameter_raw: point.$?.Descr || '',\n            value: String(value),\n            unit_raw: point.$?.Unit || '',\n            scope: 'WATER'\n        });\n    }\n}\n\nmsg.payload = {\n    metadata: {\n        description: locationDescr ? `${deviceDescr}: ${locationDescr}` : deviceDescr,\n        timeseries: sessionId,\n        origin: sessionId\n    },\n    rows\n};\nreturn [msg, null];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 890,
        "y": 140,
        "wires": [
            [
                "a2c9b230e2033698"
            ],
            []
        ]
    },
    {
