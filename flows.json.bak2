    {
        "id": "testaaditesti001",
        "type": "test inject",
        "z": "testaaditab00001",
        "name": "AADI tests",
        "onstart": true,
        "tests": "  function testDirectory(dir, expectError, expectedFailures = new Set()) {\n      return fs.readdirSync(dir)\n          .filter(f => f.endsWith('.xml'))\n          .map((f, i) => {\n              const shouldError = expectError || expectedFailures.has(f);\n              return {\n                  label: `${shouldError ? 'should error' : 'should pass'}: ${f}`,\n                  delay: 100 + i * 20,\n                  timeout: 80000,\n                  inject: { filename: path.join(dir, f) },\n                  assert: function(msg) {\n                      if (shouldError) {\n                          should(msg).have.property('error');\n                      } else {\n                          should(msg).not.have.property('error');\n                          should(msg.payload).have.property('format', 'SMARTOCEAN_V1');\n                      }\n                  }\n              };\n          });\n  }\n\n  const base = '/home/jonas/Skule/data_transformer/tests/testdata/aadi';\n\n  const nordKnownFailures = new Set([\n      '20220510T170041.xml',\n      '20220510T170041_0.xml',\n      '20220510T170041_1.xml'\n  ]);\n\n  const sorKnownFailures = new Set([\n      '20220514T121645.xml',\n      '20220520T023110.xml'\n  ]);\n\n  return [\n      ...testDirectory(`${base}/valid_data`,                  false),\n      ...testDirectory(`${base}/invalid_aadi`,                true),\n      ...testDirectory(`${base}/erroneous_data`,              true),\n      ...testDirectory(`${base}/SFI_Austevoll_NordDestination`, false, nordKnownFailures),\n      ...testDirectory(`${base}/SFI_Austevoll_SorDestination`,  false, sorKnownFailures)\n  ];\n",
        "x": 160,
        "y": 180,
        "wires": [
            [
                "testaadifilein01"
            ],
            [
                "testaadidbgrpt01"
            ]
        ]
    },
    {
